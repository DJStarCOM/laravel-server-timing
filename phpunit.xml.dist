<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kept deliberately minimal so that the same file validates against the schema of
  PHPUnit 9.5, 10.5 and 11. Everything that only exists in one of those schemas
  (backupStaticAttributes, verbose, convert*ToExceptions, filter/whitelist, logging,
  source, cacheDirectory) is passed on the command line instead - see the composer
  scripts - otherwise the runner reports a configuration warning and exits 1.
-->
<phpunit bootstrap="vendor/autoload.php"
         backupGlobals="false"
         colors="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="DJStarCOM Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
